+    def _civ_web_vgate(self, action, trajectory, intent, page_screenshot_img, meta_data, wv_url):
+        """Query web outcome-V; if P(fail)>=tau, inject 'change approach' nudge and re-predict once.
+        Mirrors desktop V-gated refiner. Passthrough (byte-identical) when V says ok."""
+        import io, base64, json, os as _os, urllib.request
+        tau=float(_os.environ.get("CIV_WEB_VTAU","0.9"))
+        audit=_os.environ.get("CIV_WEB_VAUDIT")
+        # last action string for V context
+        act_str = str(action.get("raw_prediction",""))[:200] if isinstance(action,dict) else ""
+        _pim=page_screenshot_img.convert("RGB") if page_screenshot_img.mode!="RGB" else page_screenshot_img
+        bio=io.BytesIO(); _pim.save(bio,format="JPEG",quality=70)
+        b64=base64.b64encode(bio.getvalue()).decode()
+        pf=None
+        try:
+            req=urllib.request.Request(wv_url,data=json.dumps({"screenshot_b64":b64,"action":act_str}).encode(),
+                                       headers={"Content-Type":"application/json"})
+            with urllib.request.urlopen(req,timeout=30) as r: pf=json.loads(r.read())["p_fail"]
+        except Exception: pf=None
+        fire = (pf is not None and pf>=tau)
+        if audit:
+            try:
+                with open(audit,"a") as _f: _f.write(f"pf={pf} fire={fire} tau={tau}\n")
+            except Exception: pass
+        if not fire:
+            return action  # passthrough identity
+        # re-predict with nudge appended to intent
+        nudge=("\n\n[SYSTEM HINT] The current approach appears likely to fail. Reconsider: "
+               "re-examine the page for the correct element, try a different navigation path, "
+               "or use search/filters. Avoid repeating the same ineffective action.")
+        try:
+            if self.multimodal_inputs:
+                prompt2=self.prompt_constructor.construct(trajectory, intent+nudge, page_screenshot_img, None, meta_data)
+            else:
+                prompt2=self.prompt_constructor.construct(trajectory, intent+nudge, meta_data)
+            from agent.agent import call_llm as _cl
+        except Exception:
+            pass
+        try:
+            resp2=call_llm(self.lm_config, prompt2)
+            fp=self.prompt_constructor.instruction["meta_data"].get("force_prefix","")
+            resp2=f"{fp}{resp2}"
+            parsed=self.prompt_constructor.extract_action(resp2)
+            from browser_env.actions import create_id_based_action
+            act2=create_id_based_action(parsed)
+            act2["raw_prediction"]=resp2
+            return act2
+        except Exception:
